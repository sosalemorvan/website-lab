# Example Nginx reverse proxy config for the university domain.
#
# This VPS already runs Nginx for other sites, so do NOT add this config
# until you have the real domain name to put in `server_name` below —
# without it, this block would either be ignored or risk intercepting
# traffic meant for the other sites on this box.
#
# Once you have the domain and its DNS A record points at this VPS:
#   1. Fill in server_name below
#   2. Copy to /etc/nginx/sites-available/website-lab
#   3. ln -s /etc/nginx/sites-available/website-lab /etc/nginx/sites-enabled/
#   4. nginx -t && systemctl reload nginx
#   5. certbot --nginx -d your-university-domain.example   (adds HTTPS)

server {
    listen 80;
    server_name your-university-domain.example;

    location / {
        # Must match the host port published in compose.yaml
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
